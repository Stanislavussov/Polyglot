{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreFiles": ["scripts/import-wiktionary.ts"],
  "workspaces": {
    "apps/admin": {
      "entry": ["src/pages/**/*.{astro,ts}"],
      "project": ["src/**/*.{astro,ts,vue}"],
      "ignoreFiles": ["src/components/ConfirmDialog.vue", "src/components/SettingsForm.vue"]
    },
    "apps/admin-api": {
      "project": ["src/**/*.ts"]
    },
    "apps/landing": {
      "entry": ["src/pages/**/*.astro"],
      "project": ["src/**/*.{astro,ts}"]
    },
    "apps/bot": {
      "entry": [
        "src/release-announcement.cli.ts",
        "src/dev-reset-users.cli.ts",
        "src/repair-native-translations.cli.ts",
        "src/repair-self-language-translations.cli.ts",
        "src/momentum.backfill.wiring.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "packages/adapters/ai": {
      "project": ["src/**/*.ts"]
    },
    "packages/adapters/db": {
      "project": ["src/**/*.ts"]
    },
    "packages/adapters/notifications": {
      "project": ["src/**/*.ts"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"],
      "ignoreFiles": ["src/ports/index.ts"]
    },
    "packages/infra": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": [
    "@polyglot/adapter-db",
    "@polyglot/core",
    "@polyglot/infra",
    "dotenv",
    "pino",
    "@types/bcryptjs"
  ],
  // drizzle-kit's config connects to a database, so knip's drizzle plugin cannot
  // load it without DATABASE_URL and logs a loud ERROR on any checkout without a
  // root .env — every fresh worktree, and CI. The plugin finds nothing here
  // anyway: drizzle.config.ts sits outside every workspace's `project` globs, so
  // knip's output is byte-identical with it off.
  "drizzle": false,
  "ignoreBinaries": ["dot"],
  "rules": {
    "exports": "off",
    "types": "off"
  }
}
