{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/adapters/*",
    "apps/*"
  ],
  "scripts": {
    "bot": "pnpm --filter @polyglot/bot run dev",
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs packages apps/bot/src",
    "lint:deps:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot packages apps/bot/src | dot -T svg > docs/dependency-graph.svg",
    "import:wiktionary": "tsx src/scripts/import-wiktionary.ts",
    "clean": "pnpm -r run clean && rm -rf coverage .vitest",
    "docker:up": "docker compose -f deploy/docker-compose.yml up",
    "docker:dev": "docker compose -f deploy/docker-compose.override.yml up",
    "docker:dev:build": "docker compose -f docker-compose.override.yml up --build"
  },
  "dependencies": {
    "@polyglot/adapter-db": "workspace:*",
    "@polyglot/core": "workspace:*",
    "dotenv": "^16.4.7",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^3.1.1",
    "dependency-cruiser": "^17.3.10",
    "tsx": "^4.7.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
