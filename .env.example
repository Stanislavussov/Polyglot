BOT_TOKEN=                  # Telegram Bot Token
DATABASE_URL=               # postgresql://... (Supabase connection string)
OPENROUTER_API_KEY=         # OpenRouter API key (single key for all AI providers)
BETTERSTACK_TOKEN=          # Betterstack source token
NODE_ENV=development
MOCK_PAYMENTS=on             # Test checkout (grants paid plans for free). Unset/off = buying closed, as in production

# ── Integration tests (Task 71) ──
# Used only by `pnpm test:integration`. Not needed for the app or the base
# `pnpm test`. CI provisions its own throwaway Postgres service container and
# needs none of these. Put real values in the git-ignored .env.
# See @docs/tasks/71-neon-integration-tests-ci.md.
# TEST_DATABASE_URL=        # Point the lane at any migrated+seeded Postgres (e.g. a local docker container)
# NEON_API_KEY=             # OPTIONAL Neon lane: API key (Neon console → Account → API keys)
# NEON_PROJECT_ID=          # OPTIONAL Neon lane: project id that owns the permanent `ci-base` branch

# ── Ansible / VPS Deployment ──
VPS_HOST=                  # VPS hostname or IP address
VPS_USER=root              # SSH user for Ansible; use root before first hardening run
VPS_SSH_KEY=~/.ssh/polyglot_deploy_ed25519 # Private SSH key path used by Ansible
VPS_SSH_PORT=22            # SSH port
DEPLOY_USER_SSH_KEY=       # Public SSH key installed for the deploy user; defaults to ${VPS_SSH_KEY}.pub when available
ACME_EMAIL=                # Let's Encrypt email for certbot

# ── Admin API ──
JWT_SECRET=                 # Secret for signing admin JWT tokens (required for admin-api)
ADMIN_PANEL_URL=http://localhost:4321  # Admin panel origin for CORS
ADMIN_PANEL_DOMAIN=admin.example.com   # Production admin panel hostname for deployment
ADMIN_API_PORT=3001         # Admin API host port (default: 3001)
ADMIN_EMAIL=                # Initial admin email for pnpm admin:seed
ADMIN_PASSWORD=             # Initial admin password for pnpm admin:seed

# ── Admin Panel ──
ADMIN_PORT=4321             # Admin panel host port (default: 4321)
PUBLIC_API_URL=http://localhost:3001   # Admin API URL (browser-facing)
ADMIN_API_DOMAIN=admin-api.example.com # Production admin API hostname for deployment

# ── Learner web app (dormant until enabled) ──
# Off by default: web-api starts only when COMPOSE_PROFILES contains `learn`.
COMPOSE_PROFILES=           # Set to `learn` to run the web-api container (docker compose reads this from .env)
WEB_JWT_SECRET=             # Signs learner sessions; at least 32 characters (openssl rand -hex 32)
WEB_APP_ORIGIN=http://localhost:4322   # Public origin of the web app, e.g. https://learn.example.com (required in production)
WEB_BOT_USERNAME=           # Bot the web plan page links to for upgrades; defaults to the production bot
WEB_API_PORT=3002           # web-api listen port (default: 3002)
WEB_STATIC_DIR=             # Built apps/web/dist for web-api to serve; the Docker image sets it
LEARN_DOMAIN=               # Public hostname for the web app; empty = Ansible skips the vhost
WEB_API_HOST_PORT=3002      # Host port nginx proxies LEARN_DOMAIN to (default: 3002)

# ── Monitoring / Alerting ──
# Grafana delivers provisioned alerts (bot down / update silence / translation
# errors) to this Telegram channel. Leave empty to provision the rules without a
# live destination. Consumed by deploy/monitoring/docker-compose.monitoring.yml.
GRAFANA_ALERT_TELEGRAM_BOTTOKEN=   # Telegram bot token for the alerting channel
GRAFANA_ALERT_TELEGRAM_CHATID=     # Telegram chat/channel id for alerts
READINESS_MAX_STALENESS_MS=600000  # Bot /readyz: max age of last processed update before "not ready" (default 10m)

# ── Docker Images ──
BOT_IMAGE_NAME=polyglot-bot:<git-sha>
MIGRATE_IMAGE_NAME=polyglot-migrate:<git-sha>
ADMIN_API_IMAGE_NAME=polyglot-admin-api:<git-sha>
ADMIN_IMAGE_NAME=polyglot-admin:<git-sha>
WEB_API_IMAGE_NAME=polyglot-web-api:<git-sha>   # Only pulled when COMPOSE_PROFILES=learn
