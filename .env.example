BOT_TOKEN=                  # Telegram Bot Token
DATABASE_URL=               # postgresql://... (Supabase connection string)
OPENROUTER_API_KEY=         # OpenRouter API key (single key for all AI providers)
AI_MODEL=openai/gpt-4o      # OpenRouter model ID (e.g. openai/gpt-4o, anthropic/claude-sonnet-4-20250514, google/gemini-2.5-pro)
BETTERSTACK_TOKEN=          # Betterstack source token
NODE_ENV=development

# ── Docker / Monitoring (optional) ──
METRICS_PORT=9090           # Bot metrics server port (default: 9090)
GRAFANA_PORT=3000           # Grafana UI port (default: 3000)
GRAFANA_USER=admin          # Grafana admin username (default: admin)
GRAFANA_PASSWORD=admin      # Grafana admin password (default: admin)
