{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug bot",
      "runtimeExecutable": "${userHome}/.local/share/mise/installs/node/26.1.0/bin/node",
      "runtimeArgs": ["--import", "tsx", "apps/bot/src/index.ts"],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_OPTIONS": "--conditions source"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/tsx/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Program",
      "skipFiles": ["<node_internals>/**"],
      "program": "${file}"
    }
  ]
}
