{
 "id": null,
 "uid": "polyglot-bot",
 "title": "Polyglot Bot",
 "tags": [
  "polyglot",
  "bot"
 ],
 "timezone": "browser",
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Translation Requests Rate",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "rate(bot_translations_total[5m])",
     "legendFormat": "{{status}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    }
   }
  },
  {
