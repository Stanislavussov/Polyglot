---
import LoginForm from "../components/LoginForm.vue";

const title = "Sign in";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Polyglot Admin</title>
  </head>
  <body class="flex h-screen items-center justify-center bg-gray-50">
    <div class="w-full max-w-sm">
      <div class="rounded-2xl border border-gray-200 bg-white p-8 shadow-lg">
        <div class="mb-6 text-center">
          <h1 class="text-2xl font-bold text-gray-900">Polyglot</h1>
          <p class="mt-1 text-sm text-gray-500">Admin panel sign in</p>
        </div>
        <LoginForm client:idle />
      </div>
    </div>
  </body>
</html>
