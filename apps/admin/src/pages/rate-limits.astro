---
import AdminLayout from "../layouts/AdminLayout.astro";
import RateLimitsTable from "../components/RateLimitsTable.vue";
---

<AdminLayout title="Rate Limits">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Rate Limits</h1>
      <p class="mt-1 text-sm text-gray-500">Manage plan limits and credit costs</p>
    </div>
  </div>

  <div class="mt-6" id="rate-limits-app">
    <RateLimitsTable client:idle />
  </div>
</AdminLayout>
