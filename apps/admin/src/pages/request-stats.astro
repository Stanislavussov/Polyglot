---
import AdminLayout from "../layouts/AdminLayout.astro";
import OnboardingFunnelChart from "../components/OnboardingFunnelChart.vue";
import RequestStatsManager from "../components/RequestStatsManager.vue";
---

<AdminLayout title="Request Stats">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Request Stats</h1>
      <p class="mt-1 text-sm text-gray-500">Per-user request counts by day</p>
    </div>
  </div>

  <RequestStatsManager client:load />
  <OnboardingFunnelChart client:load />
</AdminLayout>