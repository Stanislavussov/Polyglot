---
import AdminLayout from "../layouts/AdminLayout.astro";
import AIModelLatencyChart from "../components/AIModelLatencyChart.vue";
import DashboardStats from "../components/DashboardStats.vue";
import OpenRouterKeyStatus from "../components/OpenRouterKeyStatus.vue";
import RequestTimingBreakdownChart from "../components/RequestTimingBreakdownChart.vue";
---

<AdminLayout title="Dashboard">
  <h1 class="text-2xl font-bold text-gray-900">Dashboard</h1>
  <p class="mt-1 text-sm text-gray-500">Overview of your Polyglot instance</p>

  <DashboardStats client:idle />
  <OpenRouterKeyStatus client:idle />
  <AIModelLatencyChart client:idle />
  <RequestTimingBreakdownChart client:idle />
</AdminLayout>
