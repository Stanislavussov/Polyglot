{
  "name": "@polyglot/bot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "NODE_OPTIONS='--conditions source' tsx watch src/index.ts",
    "start": "node dist/index.js",
    "announce-release": "node dist/release-announcement.cli.js",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/runner": "^2.0.3",
    "@polyglot/adapter-ai": "workspace:*",
    "@polyglot/adapter-db": "workspace:*",
    "@polyglot/adapter-notifications": "workspace:*",
    "@polyglot/adapter-youtube": "workspace:*",
    "@polyglot/core": "workspace:*",
    "@polyglot/infra": "workspace:*",
    "dotenv": "^17.3.1",
    "grammy": "^1.41.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
